{
  "name": "savestate-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @checkpoint-dev/savestate build && pnpm --filter docs build",
    "test": "pnpm --filter @checkpoint-dev/savestate test",
    "lint": "pnpm --filter @checkpoint-dev/savestate lint"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
